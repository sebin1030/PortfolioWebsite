{
  "document": {
    "name": "Portfolio Website Requirements and Service Flows",
    "version": "1.0.0",
    "source_prd": "portfolio_website_prd.md",
    "updated_at": "2026-07-26"
  },
  "product": {
    "purpose": "포트폴리오 관리 및 배포",
    "description": "기획자로서의 활동과 결과물을 한눈에 볼 수 있도록 구현한 웹사이트",
    "core_users": [
      {
        "type": "owner",
        "name": "나",
        "needs": [
          "완성된 프로젝트 등록 및 관리",
          "진행 중인 활동 기록",
          "포트폴리오 지속 업데이트"
        ]
      },
      {
        "type": "recruiter",
        "name": "채용 담당자",
        "needs": [
          "기획 역량 빠른 확인",
          "프로젝트 과정과 결과 확인",
          "포트폴리오 콘텐츠 탐색"
        ]
      }
    ],
    "primary_capability": "기획",
    "access_policy": {
      "visibility": "restricted",
      "authentication": "single_shared_password",
      "authentication_required_for_all_pages": true,
      "password_prompt_on_each_visit": true,
      "logout_enabled": false,
      "future_options": [
        "share_link_token",
        "link_expiration",
        "user_login"
      ]
    }
  },
  "mvp": {
    "required_features": [
      "password_authentication",
      "home_page",
      "about_page",
      "pm_projects_category",
      "data_analysis_category",
      "vibe_coding_category",
      "contact_page",
      "project_list_page",
      "project_detail_page",
      "responsive_layout",
      "markdown_and_json_content_management"
    ],
    "excluded_features": [
      "logout",
      "github_link",
      "notion_link",
      "demo_link",
      "figma_link",
      "admin_page",
      "database_management",
      "search",
      "visitor_statistics"
    ],
    "completion_criteria": [
      "모든 페이지가 공통 비밀번호 인증으로 보호된다",
      "Home에서 자기소개와 대표 프로젝트를 확인할 수 있다",
      "About에서 PM 정체성, 철학, 기술, 성장 과정을 확인할 수 있다",
      "세 카테고리에서 프로젝트를 탐색할 수 있다",
      "모든 프로젝트에 공통 메타데이터가 적용된다",
      "완성된 프로젝트만 목록과 상세 페이지에 노출된다",
      "진행 중인 활동은 About의 Now와 Timeline에 표시된다",
      "데스크톱에서 최적화되고 모바일에서도 정상적으로 확인된다"
    ]
  },
  "content_policy": {
    "published_projects_only": true,
    "in_progress_content_location": "about.now_and_timeline",
    "project_sorting": [
      "featured_desc",
      "updated_at_desc"
    ],
    "categories": [
      {
        "id": "pm-projects",
        "name": "PM Projects",
        "description": "문제 정의, 서비스 기획, UX 설계, MVP 검증 중심 프로젝트"
      },
      {
        "id": "data-analysis",
        "name": "Data Analysis",
        "description": "데이터 분석을 통해 인사이트와 서비스 개선안을 도출한 프로젝트"
      },
      {
        "id": "vibe-coding",
        "name": "Vibe Coding",
        "description": "AI 도구와 바이브코딩을 활용한 개인 제작물과 실험"
      }
    ],
    "project_types": [
      "Personal",
      "Team",
      "Competition"
    ]
  },
  "functional_requirements": [
    {
      "id": "FR-001",
      "name": "비밀번호 인증",
      "priority": "must",
      "user": "visitor",
      "purpose": "제한된 사용자만 사이트에 접근",
      "input": "password",
      "success": "인증 성공 후 Home 또는 요청한 페이지로 이동",
      "failure": "틀린 비밀번호 안내 후 재입력",
      "logout": false
    },
    {
      "id": "FR-002",
      "name": "카테고리 탐색",
      "priority": "must",
      "user": "visitor",
      "success": "선택한 카테고리의 프로젝트 목록 표시"
    },
    {
      "id": "FR-003",
      "name": "프로젝트 목록 조회",
      "priority": "must",
      "user": "visitor",
      "sorting": "대표 프로젝트 우선 후 최신순",
      "visibility_rule": "완성된 프로젝트만 표시"
    },
    {
      "id": "FR-004",
      "name": "프로젝트 상세 조회",
      "priority": "must",
      "user": "visitor",
      "content": [
        "프로젝트 요약",
        "문제 정의",
        "기획 과정",
        "시연 화면",
        "기술 활용 내용",
        "결과",
        "회고"
      ]
    },
    {
      "id": "FR-005",
      "name": "Home 이동",
      "priority": "must",
      "user": "visitor",
      "trigger": "왼쪽 상단 로고 또는 Home 버튼 클릭",
      "success": "Home으로 이동"
    },
    {
      "id": "FR-006",
      "name": "브라우저 뒤로 가기",
      "priority": "must",
      "user": "visitor",
      "behavior": "브라우저의 기본 뒤로 가기 동작 사용"
    },
    {
      "id": "FR-007",
      "name": "프로젝트 콘텐츠 등록",
      "priority": "must",
      "user": "owner",
      "method": "Markdown 및 JSON 파일 직접 관리",
      "rule": "완성된 프로젝트만 등록"
    }
  ],
  "service_flows": {
    "primary": [
      "share_link_access",
      "password_input",
      "authentication_success",
      "home",
      "category_selection",
      "project_list",
      "project_detail",
      "review_planning_process_and_demo"
    ],
    "category_navigation": {
      "home": [
        "about",
        "pm_projects",
        "data_analysis",
        "vibe_coding",
        "contact"
      ],
      "category_to_detail": [
        "category_selection",
        "project_list",
        "project_detail"
      ]
    },
    "exceptional": [
      {
        "id": "EF-001",
        "condition": "잘못된 비밀번호",
        "flow": [
          "password_error",
          "error_message",
          "password_reinput"
        ]
      },
      {
        "id": "EF-002",
        "condition": "인증되지 않은 상태에서 내부 페이지 접속",
        "flow": [
          "redirect_to_authentication",
          "password_input",
          "authentication_success",
          "redirect_to_requested_page"
        ]
      },
      {
        "id": "EF-003",
        "condition": "존재하지 않는 프로젝트 주소",
        "flow": [
          "404_page",
          "navigate_to_project_list_or_home"
        ]
      }
    ],
    "navigation_rules": {
      "home_button": "Home으로 이동",
      "browser_back": "브라우저 기본 뒤로 가기 사용",
      "external_links": "MVP에서는 연결하지 않으며 확장 단계에서 추가"
    }
  },
  "project_common_fields": [
    "id",
    "title",
    "slug",
    "category",
    "project_type",
    "summary",
    "period",
    "role",
    "tags",
    "thumbnail",
    "content",
    "status",
    "created_at",
    "updated_at"
  ]
}
